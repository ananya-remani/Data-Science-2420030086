        "BASE_VALUE = 10\n",
        "def adjust_value(input_value):\n",
        "    return input_value * BASE_VALUE\n",
        "data_points = [2, 5, 8]\n",
        "for item in data_points:\n",
        "    print(adjust_value(item))\n"
